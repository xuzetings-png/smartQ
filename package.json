{
  "name": "smartq-learning",
  "private": true,
  "packageManager": "pnpm@10.34.2",
  "engines": {
    "node": ">=24 <25"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @smartq/api --filter @smartq/web dev",
    "build": "pnpm -r build",
    "check:runtime": "node scripts/check-runtime.mjs",
    "check:layout": "node scripts/check-layout-scroll-contract.mjs",
    "check:spec": "openspec validate --all --no-interactive && openspec validate --archived --no-interactive",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "lint:css": "stylelint \"**/*.css\"",
    "check:shell": "bash -n demo/mysql/init/*.sh",
    "check:compose": "docker compose --env-file .env.example -f demo/mysql/compose.yaml config --quiet",
    "format": "prettier --write \"**/*.{js,mjs,cjs,ts,tsx,json,jsonc,css,html,md,yaml,yml}\" \".vscode/**/*.json\" \".github/**/*.{yaml,yml}\" \"openspec/changes/**/.openspec.yaml\"",
    "format:check": "prettier --check \"**/*.{js,mjs,cjs,ts,tsx,json,jsonc,css,html,md,yaml,yml}\" \".vscode/**/*.json\" \".github/**/*.{yaml,yml}\" \"openspec/changes/**/.openspec.yaml\"",
    "check:diagnostics": "pnpm format:check && pnpm lint && pnpm lint:css && pnpm check:layout && pnpm check:shell && pnpm check:compose && pnpm build",
    "quality": "pnpm check:runtime && pnpm check:spec && pnpm check:diagnostics && pnpm test",
    "db:up": "docker compose --env-file .env.local -f demo/mysql/compose.yaml up -d",
    "db:down": "docker compose --env-file .env.local -f demo/mysql/compose.yaml down",
    "db:seed": "pnpm --filter @smartq/api db:seed"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@fission-ai/openspec": "1.13.2",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "prettier": "3.9.9",
    "stylelint": "17.15.0",
    "stylelint-config-standard": "40.0.0",
    "typescript-eslint": "8.70.1",
    "vitest": "5.0.1"
  }
}
